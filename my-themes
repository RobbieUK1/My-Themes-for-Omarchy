#!/usr/bin/env python3
"""Small custom-only theme picker for Omarchy. Python standard library only."""
from pathlib import Path
import os
import json
import re
import shutil
import subprocess
import sys
import tempfile

HOME = Path.home()
USER_THEMES = HOME / '.config/omarchy/themes'
OMARCHY_PATH = Path(os.environ.get('OMARCHY_PATH', '/usr/share/omarchy' if Path('/usr/share/omarchy').is_dir() else str(HOME / '.local/share/omarchy')))
STOCK_LOCATIONS = [OMARCHY_PATH / 'themes', Path('/usr/share/omarchy/themes'), HOME / '.local/share/omarchy/themes']
INCLUDE_FILE = HOME / '.config/my-themes-omarchy/include.txt'
EXCLUDE_FILE = HOME / '.config/my-themes-omarchy/exclude.txt'
VALID = re.compile(r'^[A-Za-z0-9_][A-Za-z0-9_.+\-]*$')


def lines(path):
    if not path.is_file():
        return set()
    return {line.strip().casefold() for line in path.read_text(encoding='utf-8').splitlines()
            if line.strip() and not line.lstrip().startswith('#')}


MANAGE_STOCK = 'Add pre-installed themes…'
HIDE_BAR = 'Hide top bar button'


def stock_themes():
    found = {}
    for root in STOCK_LOCATIONS:
        if root.is_dir():
            for path in root.iterdir():
                if path.is_dir() and VALID.fullmatch(path.name):
                    found.setdefault(path.name.casefold(), path)
    return found


def theme_paths():
    stock = stock_themes()
    include, exclude = lines(INCLUDE_FILE), lines(EXCLUDE_FILE)
    found = {key: path for key, path in stock.items() if key in include and key not in exclude}
    if USER_THEMES.is_dir():
        for path in USER_THEMES.iterdir():
            if not path.is_dir() or not VALID.fullmatch(path.name):
                continue
            if not any((path / f).exists() for f in ('colors.toml', 'alacritty.toml', 'preview.png', 'backgrounds', '.git')):
                continue
            key = path.name.casefold()
            if key not in exclude and (key not in stock or key in include):
                found[key] = path
    return found


def themes():
    return sorted((p.name for p in theme_paths().values()), key=str.casefold)


def save_stock_selection(stock, selected):
    # Preserve comments and unrelated manual inclusions. Replace atomically.
    existing = INCLUDE_FILE.read_text(encoding='utf-8').splitlines() if INCLUDE_FILE.exists() else []
    kept = [line for line in existing if line.strip().casefold() not in stock]
    content = '\n'.join(kept + sorted(selected, key=str.casefold)) + '\n'
    INCLUDE_FILE.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=INCLUDE_FILE.parent, delete=False) as file:
            temporary = Path(file.name)
            file.write(content)
        temporary.replace(INCLUDE_FILE)
    finally:
        if temporary and temporary.exists():
            temporary.unlink()


def manage_stock():
    stock = stock_themes()
    excluded = lines(EXCLUDE_FILE)
    # An explicit exclusion remains authoritative; explain it rather than silently overriding it.
    names = sorted((p.name for key, p in stock.items() if key not in excluded), key=str.casefold)
    if not names:
        print('No available pre-installed themes found. Check exclude.txt if themes are hidden.', file=sys.stderr)
        return 1
    included = lines(INCLUDE_FILE)
    if shutil.which('omarchy-menu-select'):
        argv = ['omarchy-menu-select', 'Pre-installed themes — check to include', *names, '--', '--multiple']
        for name in names:
            if name.casefold() in included:
                argv.extend(['--selected', name])
        proc = subprocess.run(argv, text=True, capture_output=True)
        if proc.returncode == 1:  # Escape: no changes.
            return 0
        if proc.returncode != 0:
            print('Could not open the pre-installed theme checklist.', file=sys.stderr)
            return 1
        try:
            selected = json.loads(proc.stdout)
        except json.JSONDecodeError:
            selected = None
        if not isinstance(selected, list) or any(not isinstance(n, str) or n not in names for n in selected):
            print('Invalid checklist result; settings unchanged.', file=sys.stderr)
            return 1
    elif sys.stdin.isatty():
        print('Pre-installed themes (currently included marked [x]):')
        for i, name in enumerate(names, 1):
            print(f"{i}. [{'x' if name.casefold() in included else ' '}] {name}")
        try:
            value = input('Enter numbers to include, comma-separated; none to clear; Enter to cancel: ').strip()
            if not value:
                return 0
            indices = [] if value.lower() == 'none' else [int(v.strip()) for v in value.split(',')]
            if any(i < 1 or i > len(names) for i in indices):
                raise ValueError
            selected = [names[i-1] for i in indices]
        except (ValueError, EOFError):
            print('Checklist cancelled; settings unchanged.', file=sys.stderr)
            return 0
    else:
        print('The checklist requires Omarchy’s native menu, or run my-themes --manage-stock in a terminal.', file=sys.stderr)
        return 1
    editable = {n.casefold() for n in names}
    save_stock_selection(editable, selected)
    return 0


def current():
    if shutil.which('omarchy'):
        try:
            result = subprocess.run(['omarchy', 'theme', 'current'], capture_output=True, text=True, timeout=8)
            if result.returncode == 0:
                return result.stdout.strip().splitlines()[0].strip().lower().replace(' ', '-') if result.stdout.strip() else ''
        except (OSError, subprocess.TimeoutExpired):
            pass
    path = HOME / '.local/state/omarchy/current/theme.name'
    try:
        return path.read_text(encoding='utf-8').strip()
    except OSError:
        return ''


def previews(names, active):
    """Use Omarchy's own thumbnail UI without copying wallpapers."""
    if not shutil.which('omarchy-menu-images'):
        return picker([('[active] ' if n.casefold() == active else '') + n for n in names])
    with tempfile.TemporaryDirectory(prefix='my-themes-') as directory:
        available = {}
        for name in names:
            root = theme_paths().get(name.casefold(), USER_THEMES / name)
            images = [root / 'preview.png', root / 'preview.jpg']
            for backgrounds in (HOME / '.config/omarchy/backgrounds' / name, root / 'backgrounds'):
                if backgrounds.is_dir():
                    images.extend(sorted(backgrounds.iterdir()))
            source = next((p for p in images if p.is_file() and p.suffix.lower() in ('.png', '.jpg', '.jpeg', '.webp')), None)
            if source:
                label = ('[active] ' if name.casefold() == active else '') + name
                link = Path(directory) / (label + source.suffix.lower())
                link.symlink_to(source.resolve())
                available[str(link)] = label
        # Every theme must remain selectable, including themes without images.
        if len(available) != len(names):
            print('Some themes have no preview; using the complete searchable list.', file=sys.stderr)
            return picker([('[active] ' if n.casefold() == active else '') + n for n in names])
        argv = ['omarchy-menu-images', '--show-labels', '--filterable']
        selected = next((p for p, label in available.items() if label.startswith('[active] ')), None)
        if selected:
            argv.extend(['--selected', selected])
        proc = subprocess.run(argv + [directory], text=True, capture_output=True)
        return available.get(proc.stdout.strip()) if proc.returncode == 0 else None


def picker(options):
    if shutil.which('omarchy-menu-select'):
        proc = subprocess.run(['omarchy-menu-select', 'My Themes for Omarchy', *options], text=True, capture_output=True)
        if proc.returncode in (0, 1):
            return proc.stdout.strip() if proc.returncode == 0 else None

    # fuzzel is Wayland native; rofi/wofi support many Omarchy versions.
    candidates = [(['fuzzel', '--dmenu', '--prompt', 'My Themes > '], 'fuzzel'),
                  (['rofi', '-dmenu', '-i', '-p', 'My Themes'], 'rofi'),
                  (['wofi', '--dmenu', '--insensitive', '--prompt', 'My Themes'], 'wofi')]
    for argv, name in candidates:
        if shutil.which(name):
            proc = subprocess.run(argv, input='\n'.join(options) + '\n', text=True, capture_output=True)
            return proc.stdout.strip() if proc.returncode == 0 else None
    if sys.stdin.isatty():
        print('My Themes — choose a number:')
        for i, opt in enumerate(options, 1):
            print(f'{i}. {opt}')
        try:
            value = int(input('Selection (Enter to cancel): '))
            return options[value-1] if 1 <= value <= len(options) else None
        except (ValueError, EOFError):
            return None
    print('Install fuzzel, rofi, or wofi for a graphical picker.', file=sys.stderr)
    return None


def hide_bar():
    choice = picker(['Hide top bar button', 'Cancel'])
    if choice != 'Hide top bar button':
        return 0
    if not shutil.which('omarchy'):
        print('Omarchy plugin command not found.', file=sys.stderr)
        return 1
    return subprocess.call(['omarchy', 'plugin', 'disable', 'io.github.robbieuk1.my-themes'])


def main():
    if any(arg not in ('--list', '--previews', '--manage-stock', '--hide-bar', '--help') for arg in sys.argv[1:]):
        print('Unknown option. Use --help.', file=sys.stderr)
        return 2
    if '--help' in sys.argv:
        print('My Themes for Omarchy v0.2\nUsage: my-themes [--list | --previews | --manage-stock | --hide-bar | --help]')
        return 0
    if '--hide-bar' in sys.argv:
        return hide_bar()
    if '--manage-stock' in sys.argv:
        return manage_stock()
    names = themes()
    if len(sys.argv) > 1 and sys.argv[1] == '--list':
        print('\n'.join(names))
        return 0
    while True:
        active = current().casefold()
        shown = [('[active] ' if name.casefold() == active else '') + name for name in names]
        if '--previews' in sys.argv and names:
            choice = previews(names, active)
        else:
            choice = picker(shown + [MANAGE_STOCK, HIDE_BAR])
        if choice != MANAGE_STOCK:
            break
        result = manage_stock()
        if result:
            return result
        names = themes()
    if choice == HIDE_BAR:
        return hide_bar()
    if not choice:
        return 0
    selection = choice.removeprefix('[active] ')
    # Validate selections against the original enumeration, not arbitrary picker output.
    if selection not in names:
        print('Invalid theme selection.', file=sys.stderr)
        return 1
    if shutil.which('omarchy'):
        return subprocess.call(['omarchy', 'theme', 'set', selection])
    if shutil.which('omarchy-theme-set'):
        return subprocess.call(['omarchy-theme-set', selection])
    print('Omarchy theme command not found.', file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
